# MiniMax API 配置（使用 Anthropic 兼容接口）
ANTHROPIC_API_KEY=your-minimax-api-key-here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.1

# MiniMax 流式传输兼容性配置
# ========================================
# CRITICAL for MiniMax M2.1 reasoning models - DO NOT remove these settings

# API_TIMEOUT_MS: SDK默认30秒超时太短，会导致MiniMax M2.1推理任务中断
# 设置为3000秒(3000000ms)以支持复杂的深度思考任务
API_TIMEOUT_MS=3000000

# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: 减少非必要流量，降低SSE流解析压力
# 在MiniMax高速流式传输(100 TPS)场景下避免解析器崩溃
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# 参考文档: .planning/research/SDK与MiniMax流式传输实现的兼容性架构与工程解决方案深度报告.md
# ========================================

# 可用模型:
# - MiniMax-M2.1: 多语言编程优化，60 tps，质量与速度平衡（推荐）
# - MiniMax-M2.1-lightning: 极速版本，100 tps
# - MiniMax-M2: 专为 Agent 工作流优化

# 获取 API Key:
# 1. 访问 https://platform.minimaxi.com
# 2. 注册账号并创建 API Key
# 3. 将 Key 粘贴到上方

# NotebookLM 笔记本名称（可选，默认为 my_knowledge）
NOTEBOOK_NAME=my_knowledge

# 日志配置
# 工具结果最大长度（0或空表示不截断，其他值表示截断字符数）
LOG_MAX_RESULT_LENGTH=0

# Prompt 配置
# 指定使用哪个版本的 prompt 文件（write_prompt/ 目录下的 .md 文件）
# 例如：V1 会使用 write_prompt/V1.md
#      V2 会使用 write_prompt/V2.md
# 默认：V1
PROMPT_VERSION=V1

# 飞书应用凭证
FEISHU_APP_ID=cli_a80711ecf739501c
FEISHU_APP_SECRET=OAn5WYMgPMCNF7uwipPYDS5s5GvMid1k

