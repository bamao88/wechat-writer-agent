# MiniMax API 配置（使用 Anthropic 兼容接口）
ANTHROPIC_API_KEY=your-minimax-api-key-here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.1

# 可用模型:
# - MiniMax-M2.1: 多语言编程优化，60 tps，质量与速度平衡（推荐）
# - MiniMax-M2.1-lightning: 极速版本，100 tps
# - MiniMax-M2: 专为 Agent 工作流优化

# 获取 API Key:
# 1. 访问 https://platform.minimaxi.com
# 2. 注册账号并创建 API Key
# 3. 将 Key 粘贴到上方

# NotebookLM 笔记本名称（可选，默认为 my_knowledge）
NOTEBOOK_NAME=my_knowledge

# 飞书应用凭证
FEISHU_APP_ID=cli_a80711ecf739501c
FEISHU_APP_SECRET=OAn5WYMgPMCNF7uwipPYDS5s5GvMid1k

